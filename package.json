{
  "name": "@arylo/esbuild-plugin-html-minify-text",
  "version": "1.0.1",
  "description": "An esbuild plugin that minifies HTML files and returns them as text loader payload",
  "keywords": [
    "esbuild",
    "esbuild-plugin",
    "html",
    "html-minify",
    "htmlnano"
  ],
  "homepage": "https://github.com/arylo-scripts/esbuild-plugin-html-minify-text#readme",
  "bugs": {
    "url": "https://github.com/arylo-scripts/esbuild-plugin-html-minify-text/issues"
  },
  "license": "MIT",
  "author": "Arylo Yeung <arylo.open@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/arylo-scripts/esbuild-plugin-html-minify-text.git"
  },
  "files": [
    "dist",
    "LICENSE",
    "README-zh.md",
    "CHANGELOG.md"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "rimraf dist",
    "prepare": "npm run build",
    "prepublishOnly": "npm run build",
    "lint": "concurrently -m 1 --timings npm:lint:*",
    "lint:type-check": "tsc -p tsconfig.json --noEmit",
    "lint:formatter": "oxfmt --check",
    "lint:oxlint": "oxlint",
    "fix:formatter": "oxfmt"
  },
  "dependencies": {
    "htmlnano": "^2.1.1"
  },
  "devDependencies": {
    "@arylo-scripts/tsconfig": "^1.0.0",
    "@types/node": "^24.12.0",
    "concurrently": "^8.2.2",
    "oxfmt": "^0.35.0",
    "oxlint": "^1.58.0",
    "rimraf": "^6.1.3",
    "typescript": "~5.9.3"
  },
  "peerDependencies": {
    "esbuild": "^0.28.0"
  },
  "engines": {
    "node": "24.12.0"
  },
  "packageManager": "npm@11.6.2"
}
